# Normalize line endings to LF in the repository; let git decide text vs binary.
* text=auto eol=lf

# Shell scripts must keep LF even on a Windows checkout, or the shebang line breaks.
*.sh text eol=lf

# Diff-friendly language hint for the skill's Node scripts.
*.mjs text diff=javascript

# Drill corpus cases carry a git bundle: binary, never line-ending normalized.
*.bundle -text

# Every change adds its lines under [Unreleased]; only a release writes a version heading, so a union never interleaves two sections.
/CHANGELOG.md merge=union
